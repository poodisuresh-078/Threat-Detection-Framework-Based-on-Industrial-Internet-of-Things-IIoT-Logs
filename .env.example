# Environment Configuration Example for IIoT Threat Detection Framework
# Copy this file to .env and customize values for production deployment

# Flask Secret Key for session management and CSRF security
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Flask Environment mode: development or production
FLASK_ENV=development
FLASK_DEBUG=0

# Database file path (defaults to instance/iiot_security.db or iiot_security.db)
DATABASE_PATH=iiot_security.db

# Upload Limits (in bytes; 16MB default = 16777216)
MAX_CONTENT_LENGTH=16777216

# Server Port and Host
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

